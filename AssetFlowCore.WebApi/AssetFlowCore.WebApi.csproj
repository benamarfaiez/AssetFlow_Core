    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetFlowCore.Application\AssetFlowCore.Application.csproj" />
    <ProjectReference Include="..\AssetFlowCore.Infrastructure\AssetFlowCore.Infrastructure.csproj" />
  </ItemGroup>

</Project>
